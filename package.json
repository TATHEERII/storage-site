    "jsonwebtoken": "^9.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^7.18.2",
    "uuid": "^11.1.0"
